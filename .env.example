# Web Search Provider Configuration
# Options: exa, firecrawl, tavily, brave, google_custom
SEARCH_PROVIDER=exa

# Exa API (https://exa.ai)
EXA_API_KEY=your_exa_api_key_here

# Firecrawl API (https://www.firecrawl.dev)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# Tavily API (https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_API_BASE_URL=https://api.tavily.com

# Brave Search API (https://brave.com/search/api)
BRAVE_API_KEY=your_brave_api_key_here

# Google Custom Search API (https://programmablesearchengine.google.com)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CSE_ID=your_google_cse_id_here

# Search Configuration
DEFAULT_SEARCH_NUM_RESULTS=5
SEARCH_QUERY_TYPE=web

# Tool Call Configuration
TOOL_CALL_ERROR_MAX_RETRIES=5

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=myapp
DB_USER=admin
DB_PASSWORD=password123

# Model Configuration
# MODEL_PROVIDER: "openai_compatible" (local/self-hosted, default), "openai" (OpenAI cloud), "anthropic"
MODEL_PROVIDER=openai_compatible
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=http://192.168.86.34:8083/v1
MODEL_NAME=Qwen3-Coder-30b

# Anthropic API (used when MODEL_PROVIDER=anthropic)
# Recommended models: claude-opus-4-6, claude-sonnet-4-6, claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# API Configuration
API_KEY=your_api_key_here
API_URL=https://api.example.com

# Application Configuration
DEBUG=true
PORT=3000

# External Knowledge Layer
# GitHub API Token (optional) - raises rate limit from 60/hr to 5000/hr
# Create at: https://github.com/settings/tokens (no special scopes needed for public search)
GITHUB_TOKEN=your_github_token_here