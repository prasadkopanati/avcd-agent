# Web Search Provider Configuration
# Options: exa, firecrawl, tavily, brave, openserp, google_custom
SEARCH_PROVIDER=exa

# Exa API (https://exa.ai)
EXA_API_KEY=your_exa_api_key_here

# Firecrawl API (https://www.firecrawl.dev)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# Tavily API (https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_API_BASE_URL=https://api.tavily.com

# Brave Search API (https://brave.com/search/api)
BRAVE_API_KEY=your_brave_api_key_here

# OpenSerp (self-hosted - https://github.com/karust/openserp)
OPENSERP_BASE_URL=http://localhost:7000
OPENSERP_ENGINES=google,bing,duckduckgo

# Google Custom Search API (https://programmablesearchengine.google.com)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CSE_ID=your_custom_search_engine_id_here

# Search Configuration
DEFAULT_SEARCH_NUM_RESULTS=5
SEARCH_QUERY_TYPE=web

# Tool Call Configuration
TOOL_CALL_ERROR_MAX_RETRIES=5

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=myapp
DB_USER=admin
DB_PASSWORD=password123

# Model Configuration
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=http://192.168.86.34:8083/v1
MODEL_NAME=Qwen3-Coder-30b

# API Configuration
API_KEY=your_api_key_here
API_URL=https://api.example.com

# Application Configuration
DEBUG=true
PORT=3000